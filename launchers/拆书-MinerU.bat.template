@echo off
chcp 936 >nul
set "SPLIT_OUTPUT_ENCODING=gbk"
title 拆书工具 - MinerU 一体化（云端 OCR + 按章拆分）

set "PY={{PYTHON}}"
set "SCRIPT={{VAULT_PATH}}\_工具\split_textbook.py"
set "OUT={{VAULT_PATH}}\04-教材分块"
set "TOKEN_FILE={{TOKEN_FILE}}"
set "MINERU_CLI={{MINERU_CLI}}"

rem 传递给 Python 脚本（可移植路径解析）
set "AIWF_MINERU_TOKEN_FILE=%TOKEN_FILE%"
if exist "%MINERU_CLI%" set "AIWF_MINERU_CLI=%MINERU_CLI%"

echo ================================================
echo   拆书工具 - MinerU 一体化
echo   教材 PDF  -^> MinerU 云端解析 + 按章拆分（公式转 LaTeX）
echo   已有 00-MinerU解析全文.md -^> 直接按章重切分（不耗额度）
echo   一章一个文件，输出在「04-教材分块」中
echo ================================================
echo.

rem 方式一：直接把文件拖到 bat 图标上
set "FILE=%~1"
if defined FILE goto check_type

rem 方式二：粘贴路径后回车
echo 请把教材 PDF 或 00-MinerU解析全文.md 直接"拖进本窗口"，然后按回车：
set /p "FILE="
set "FILE=%FILE:"=%

:check_type
if not defined FILE set "FILE="
if "%FILE%"=="" (
    echo.
    echo 没有输入文件路径，即将退出。
    pause
    exit /b
)

echo.
echo 已选择：%FILE%
echo.

rem 如果是 .md（MinerU 解析全文）-> 直接按章重切分，不耗额度
set "EXT=%FILE:~-3%"
if /i "%EXT%"==".md" goto resplit

rem 否则按 PDF 走 MinerU 云端解析
goto mineru

:mineru
set "TOKEN="
if exist "%TOKEN_FILE%" (
    set /p TOKEN=<"%TOKEN_FILE%"
)
if not defined TOKEN set "TOKEN="
if "%TOKEN%"=="" (
    echo.
    echo 还没保存 MinerU Token。
    echo 请先运行 _工具\设置MinerU令牌.bat 保存一次，也可以现在直接粘贴：
    set /p "TOKEN=粘贴 MinerU Token: "
)

if not exist "%MINERU_CLI%" (
    echo.
    echo [提示] 未找到 mineru-open-api 命令行工具。
    echo 安装方式：_工具\.venv\Scripts\pip.exe install mineru-open-api
    echo 或重新运行 install.ps1（不跳过 MinerU）。
    echo.
    pause
    exit /b
)

echo 输出位置：%OUT%
echo 正在上传 MinerU 云端解析并按章拆分，750 页约需 20-40 分钟，请耐心等待...
echo.

if "%TOKEN%"=="" (
    "%PY%" "%SCRIPT%" "%FILE%" --out "%OUT%" --ocr mineru --split-mode chapter
) else (
    "%PY%" "%SCRIPT%" "%FILE%" --out "%OUT%" --ocr mineru --split-mode chapter --mineru-token "%TOKEN%"
)
goto done

:resplit
echo 检测到 MinerU 解析全文，直接按章节重新拆分，不消耗 MinerU 额度...
echo.
"%PY%" "%SCRIPT%" "%FILE%" --out "%OUT%" --split-mode chapter
goto done

:done
if errorlevel 1 goto fail
echo.
echo [成功] 拆书完成！
echo 新文件已保存到：%OUT%
echo 在 Obsidian 的「04-教材分块」文件夹中查看。
echo.
pause
exit /b

:fail
echo.
echo [失败] 处理未成功，请把上方窗口里的错误信息发给 AI。
echo 常见原因：网络不稳定、Token 无效、超过每日免费页数。
echo.
pause
