@echo off
chcp 936 >nul
title 保存 MinerU Token

set "TOKEN_FILE={{TOKEN_FILE}}"

echo ================================================
echo   保存 MinerU Token（免费注册：https://mineru.net）
echo   登录后：API 令牌 -^> 创建令牌 -^> 复制
echo ================================================
echo.
set /p "TOKEN=粘贴 Token: "
if "%TOKEN%"=="" (
    echo 没有输入，即将退出。
    pause
    exit /b
)

> "%TOKEN_FILE%" echo %TOKEN%
echo.
echo 已保存到 %TOKEN_FILE%
pause
